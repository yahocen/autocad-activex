<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.yahocen</groupId>
    <artifactId>autocad-activex</artifactId>
    <version>1.0.0</version>

    <name>autocad-activex</name>
    <description>AutoCAD ActiveX/COM automation for Java: generic COM bridge (io.github.yahocen.jacob, JACOB fork) + typed AutoCAD object model (io.github.yahocen.acad). Bundles jacobcom.dll, extracted and loaded at runtime. Late-bound (IDispatch): one mapping set drives multiple AutoCAD versions.</description>
    <url>https://github.com/yahocen/autocad-activex</url>

    <!-- 项目主体 Apache-2.0；jacob COM 桥接组件为 JACOB fork，沿用 LGPL-2.1（见 NOTICE / LICENSE-LGPL-2.1） -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>yahocen</id>
            <name>Yahocen</name>
            <email>yahocen@hotmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/yahocen/autocad-activex.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yahocen/autocad-activex.git</developerConnection>
        <url>https://github.com/yahocen/autocad-activex</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.42</lombok.version>
        <swagger.version>2.2.41</swagger.version>
        <slf4j.version>2.0.17</slf4j.version>
    </properties>

    <!-- 依赖面最小化：运行时仅 swagger-annotations（文档契约）+ slf4j-api（日志门面），
         均无传递依赖；lombok 编译期消失。窗口操作走自带 jacobcom.dll 的 JNI，不引 JNA；
         浅层工具用内部 Internal 类，不引 hutool。 -->
    <dependencies>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 发布到 Maven Central（Sonatype Central Portal）：mvn clean deploy -P release
             autoPublish=false：上传并通过校验后停在 Portal 的 VALIDATED 状态，
             需登录 https://central.sonatype.com/publishing 人工确认后点 Publish -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central 要求 javadoc jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <charset>UTF-8</charset>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Central 要求所有构件 GPG 签名；passphrase 在 ~/.m2/settings.xml 的 gpg-signing profile -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- 上传到 Central Portal，server id 对应 settings.xml 中的 <server><id>central</id> -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
